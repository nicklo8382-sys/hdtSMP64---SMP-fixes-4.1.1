diff --git a/src/hdtSkyrimBody.cpp b/src/hdtSkyrimBody.cpp
index aaab462..031b909 100644
--- a/src/hdtSkyrimBody.cpp
+++ b/src/hdtSkyrimBody.cpp
@@ -41,10 +41,96 @@ namespace hdt
 		return SkinnedMeshBody::canCollideWith(rhs);
 	}
 
+	void SkyrimBody::refreshMorphedPositions()
+	{
+		if (m_origVertexIndex.size() != m_vertices.size())
+			return;
+
+		for (auto& src : m_morphSources) {
+			auto* shape = src.shape.get();
+			if (!shape || !src.vertexCount)
+				continue;
+
+			auto& rd = shape->GetDynamicTrishapeRuntimeData();
+			RE::BSSpinLockGuard guard(rd.lock);
+
+			const auto* data = static_cast<const uint8_t*>(rd.dynamicData);
+			if (!data)
+				continue;
+			// dynamicData holds one 16-byte entry (x, y, z, pad) per vertex; skip if the buffer is smaller than expected
+			if (rd.dataSize && rd.dataSize < src.vertexCount * 16 && rd.dataSize != src.vertexCount)
+				continue;
+
+			const uint32_t begin = src.vertexStart;
+			const uint32_t end = src.vertexStart + src.vertexCount;
+			for (size_t k = 0; k < m_vertices.size(); ++k) {
+				const uint32_t o = m_origVertexIndex[k];
+				if (o < begin || o >= end)
+					continue;
+				const auto* p = reinterpret_cast<const RE::NiPoint3*>(data + static_cast<size_t>(o - begin) * 16);
+				m_vertices[k].m_skinPos = convertNi(*p);
+			}
+		}
+	}
+
+	void SkyrimBody::refreshMeshPositions()
+	{
+		if (m_origVertexIndex.size() != m_vertices.size())
+			return;
+
+		// full re-read every ~10 s of updates even if the buffer pointer is unchanged (covers in-place edits)
+		const bool periodic = (++m_meshRefreshCounter % 600) == 0;
+
+		for (auto& src : m_meshSources) {
+			auto* shape = src.shape.get();
+			if (!shape || !src.vertexCount)
+				continue;
+
+			auto* skinInstance = shape->GetGeometryRuntimeData().skinInstance.get();
+			if (!skinInstance)
+				continue;
+			// hold a reference so the partition can't be freed under us if a morph swaps it mid-read
+			RE::NiPointer<RE::NiSkinPartition> skinPartition = skinInstance->skinPartition;
+			if (!skinPartition || skinPartition->numPartitions == 0 || skinPartition->vertexCount != src.vertexCount)
+				continue;
+
+			auto* partition = skinPartition->partitions.data();
+			if (!partition || !partition->buffData)
+				continue;
+			const uint8_t* vertexBlock = partition->buffData->rawVertexData;
+			if (!vertexBlock)
+				continue;
+			if (vertexBlock == src.lastData && !periodic)
+				continue;
+
+			const auto vFlags = partition->vertexDesc.GetFlags();
+			if (!(vFlags & RE::BSGraphics::Vertex::Flags::VF_VERTEX))
+				continue;
+			const auto vSize = partition->vertexDesc.GetSize();
+			if (!vSize)
+				continue;
+
+			const uint32_t begin = src.vertexStart;
+			const uint32_t end = src.vertexStart + src.vertexCount;
+			for (size_t k = 0; k < m_vertices.size(); ++k) {
+				const uint32_t o = m_origVertexIndex[k];
+				if (o < begin || o >= end)
+					continue;
+				const auto* p = reinterpret_cast<const RE::NiPoint3*>(vertexBlock + static_cast<size_t>(o - begin) * vSize);
+				m_vertices[k].m_skinPos = convertNi(*p);
+			}
+			src.lastData = vertexBlock;
+		}
+	}
+
 	void SkyrimBody::internalUpdate()
 	{
 		if (m_disabled)
 			return;
+		if (!m_morphSources.empty())
+			refreshMorphedPositions();
+		if (!m_meshSources.empty())
+			refreshMeshPositions();
 		SkinnedMeshBody::internalUpdate();
 	}
 }
diff --git a/src/hdtSkyrimBody.h b/src/hdtSkyrimBody.h
index 7e89e56..3771308 100644
--- a/src/hdtSkyrimBody.h
+++ b/src/hdtSkyrimBody.h
@@ -30,5 +30,33 @@ namespace hdt
 
 		bool canCollideWith(const SkinnedMeshBody* body) const override;
 		void internalUpdate() override;
+
+		// [FacialMorphCollision] Face geometry (BSDynamicTriShape) gets its vertices rewritten by the game every time
+		// facial morphs change (expressions, phonemes, MFEE, PPA...). Stock FSMP only reads those positions once when the
+		// system is built, so collisions use the neutral face. We keep a reference to the dynamic shape and re-read the
+		// morphed positions before every skinning update.
+		struct MorphSource
+		{
+			RE::NiPointer<RE::BSDynamicTriShape> shape;
+			uint32_t vertexStart = 0;  // first vertex of this mesh in the (pre-compaction) body vertex list
+			uint32_t vertexCount = 0;
+		};
+		std::vector<MorphSource> m_morphSources;
+		void refreshMorphedPositions();
+
+		// [BodyMorphCollision] Body / armor / schlong geometry (plain BSTriShape). RaceMenu / OBody body morphs replace
+		// the shape's skin partition (and its vertex buffer) after the physics system was built, so stock FSMP keeps
+		// colliding against the un-morphed BodySlide shape. We keep the shape and re-read its vertex positions whenever
+		// the vertex buffer changes (checked every update, cheap), plus a slow periodic refresh for in-place edits.
+		struct MeshSource
+		{
+			RE::NiPointer<RE::BSTriShape> shape;
+			uint32_t                      vertexStart = 0;
+			uint32_t                      vertexCount = 0;
+			const void*                   lastData = nullptr;  // vertex buffer the positions were last read from
+		};
+		std::vector<MeshSource> m_meshSources;
+		uint32_t                m_meshRefreshCounter = 0;
+		void                    refreshMeshPositions();
 	};
 }
